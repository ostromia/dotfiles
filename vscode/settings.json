{
	// Text Editor
	"editor.autoClosingBrackets": "never",
	"editor.autoClosingQuotes": "never",
	"editor.autoSurround": "never",
	"editor.bracketPairColorization.enabled": false,
	"editor.codeLens": false,
	"editor.colorDecorators": false,
	"editor.detectIndentation": false,
	"editor.folding": true,
	"editor.guides.indentation": false,
	"editor.insertSpaces": false,
	"editor.lightbulb.enabled": "off",
	"editor.lineNumbers": "relative",
	"editor.occurrencesHighlight": "off",
	"editor.renderWhitespace": "none",
	"editor.rulers": [ 80, 100 ],
	"editor.scrollBeyondLastLine": false,
	"editor.stickyScroll.enabled": false,
	"editor.tabSize": 4,
	"editor.unicodeHighlight.ambiguousCharacters": true,
	"editor.unicodeHighlight.invisibleCharacters": true,

	// Text Editor > Cursor
	"editor.cursorBlinking": "solid",

	// Text Editor > Font
	"editor.fontFamily": "Menlo",
	"editor.fontLigatures": false,
	"editor.fontSize": 18,
	"editor.fontVariations": false,
	"editor.fontWeight": "normal",

	// Text Editor > Formatting
	"editor.formatOnPaste": false,
	"editor.formatOnSave": false,

	// Text Editor > Diff Editor
	"diffEditor.ignoreTrimWhitespace": false,

	// Text Editor > Minimap
	"editor.minimap.enabled": false,

	// Text Editor > Suggestions
	"editor.quickSuggestions": {
		"other": "off",
		"comments": "off",
		"strings": "off",
	},
	"editor.suggestOnTriggerCharacters": false,

	// Text Editor > Files
	"files.autoSave": "off",
	"files.enableTrash": true,
	"files.insertFinalNewline": true,
	"files.refactoring.autoSave": false,
	"files.restoreUndoStack": true,
	"files.trimFinalNewlines": false,
	"files.trimTrailingWhitespace": true,

	// Workbench
	"workbench.enableExperiments": false,
	"workbench.layoutControl.enabled": false,
	"workbench.localHistory.enabled": false,
	"workbench.startupEditor": "none",
	"workbench.welcomePage.walkthroughs.openOnInstall": false,

	// Workbench > Appearance
	"workbench.activityBar.location": "hidden",
	"workbench.colorCustomizations": {
		"scrollbar.shadow": "#0000",
		"focusBorder": "#0000",
	},
	"workbench.colorTheme": "Atom One Dark",
	"workbench.editor.decorations.colors": false,
	"workbench.iconTheme": "vs-seti",
	"workbench.sideBar.location": "right",
	"workbench.tips.enabled": false,
	"workbench.tree.enableStickyScroll": false,
	"workbench.tree.indent": 16,
	"workbench.tree.renderIndentGuides": "none",

	// Workbench > Breadcrumbs
	"breadcrumbs.enabled": false,

	// Workbench > Editor Management
	"workbench.editor.decorations.badges": false,
	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.labelFormat": "default",
	"workbench.editor.languageDetection": false,
	"workbench.editor.languageDetectionHints": {
		"untitledEditors": false,
		"notebookEditors": false
	},
	"workbench.editor.restoreViewState": false,
	"workbench.editor.sharedViewState": false,
	"workbench.editor.showIcons": false,
	"workbench.editor.tabActionCloseVisibility": false,
	"workbench.editor.tabSizing": "fixed",
	"workbench.editor.useModal": "off",
	"workbench.editor.wrapTabs": true,

	// Window
	"window.commandCenter": false,
	"window.customTitleBarVisibility": "windowed",
	"window.restoreWindows": "none",
	"window.title": "${activeEditorMedium}",

	// Chat
	"chat.disableAIFeatures": true,

	// Features > Explorer
	"explorer.autoReveal": false,
	"explorer.compactFolders": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.confirmPasteNative": false,
	"explorer.decorations.badges": false,
	"explorer.decorations.colors": true,
	"explorer.excludeGitIgnore": false,
	"explorer.sortOrder": "type",

	// Features > Debug
	"debug.internalConsoleOptions": "neverOpen",

	// Features > Source Control
	"scm.diffDecorations": "all",

	// Features > Extensions
	"extensions.autoCheckUpdates": false,
	"extensions.autoUpdate": false,
	"extensions.ignoreRecommendations": true,

	// Features > Terminal
	"terminal.external.osxExec": "Terminal.app",
	"terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
	"terminal.integrated.drawBoldTextInBrightColors": false,
	"terminal.integrated.enablePersistentSessions": false,
	"terminal.integrated.enableVisualBell": false,
	"terminal.integrated.initialHint": false,
	"terminal.integrated.persistentSessionReviveProcess": "never",
	"terminal.integrated.persistentSessionScrollback": 0,
	"terminal.integrated.shellIntegration.decorationsEnabled": "never",

	// Application > Update
	"update.mode": "none",

	// Application > Telemetry
	"telemetry.feedback.enabled": false,
	"telemetry.telemetryLevel": "off",

	// Security > Workspace
	"security.workspace.trust.enabled": false,

	// !formatting
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features",
	},

	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features",
	},

	"json.format.keepLines": true,

	// END END END

	// Extensions
	"prettier.printWidth": 200,
	"prettier.tabWidth": 4,
	"prettier.useTabs": false,

	"git.confirmSync": false,
	"git.ignoreMissingGitWarning": true,
	"git.terminalAuthentication": false,

	"vim.useSystemClipboard": true,
	"vim.autoindent": false,
	"vim.enableNeovim": false,

	"vim.handleKeys": {
		"<C-n>": false,
		"<C-z>": false,
		"<C-y>": false,
	},

	"vim.normalModeKeyBindings": [
		{ "before": [ "w" ], "after": [ "b" ] },
		{ "before": [ ";" ], "after": [ ":" ] },
	],

	"vim.visualModeKeyBindings": [
		{ "before": [ "w" ], "after": [ "b" ] },
		{ "before": [ "Tab" ], "commands": [ "tab" ] },
		{ "before": [ "<S-Tab>" ], "commands": [ "outdent" ] },
	],

	"vim.normalModeKeyBindingsNonRecursive": [
		{
			"before": [ "p" ],
			"commands": [ "editor.action.clipboardPasteAction", "extension.vim_escape" ],
		},
	],

	"vim.visualModeKeyBindingsNonRecursive": [
		{
			"before": [ "p" ],
			"commands": [ "editor.action.clipboardPasteAction", "extension.vim_escape" ],
		},
		{
			"before": [ "y" ],
			"commands": [ "editor.action.clipboardCopyAction", "extension.vim_escape" ],
		},
	],

	"cSpell.language": "en-GB",
	"cSpell.languageSettings": [
		{
			"languageId": "*",
			"enabled": false,
		},
		{
			"languageId": "markdown",
			"enabled": true,
		},
	],

	"markdownlint.config": {
		"MD007": {
			"indent": 4,
		},
	},

	"typescript.tsdk": "./node_modules/typescript/lib",

	"html.autoClosingTags": false,
	"[vhdl]": {
		"editor.defaultFormatter": "HaarigerHarald.vhdl-formatter-pp",
	},
	"tinymist.completion.postfixUfcsRight": false,
	"tinymist.completion.postfixUfcsLeft": false,
	"tinymist.completion.postfixUfcs": false,
	"tinymist.completion.postfix": false,
	"tinymist.inlayHints.packageVersionStatus": false,
	"tinymist.compileStatus": "disable",

	// end

	"editor.wordBasedSuggestions": "off",
	"editor.acceptSuggestionOnEnter": "off",
	"editor.acceptSuggestionOnCommitCharacter": false,
	"editor.tabCompletion": "off",
	"editor.snippetSuggestions": "none",
	"editor.parameterHints.enabled": false,
	"editor.inlineSuggest.enabled": false,
	"editor.suggest.preview": false,
	"editor.suggest.showStatusBar": false,
	"editor.suggest.snippetsPreventQuickSuggestions": true,
	"editor.selectionHighlight": false,
	"editor.matchBrackets": "never",
	"editor.linkedEditing": false,

	// end 2

	// "editor.suggest.showMethods": false,
	// "editor.suggest.showFunctions": false,
	// "editor.suggest.showConstructors": false,
	// "editor.suggest.showDeprecated": false,
	// "editor.suggest.showFields": false,
	// "editor.suggest.showVariables": false,
	// "editor.suggest.showClasses": false,
	// "editor.suggest.showStructs": false,
	// "editor.suggest.showInterfaces": false,
	// "editor.suggest.showModules": false,
	// "editor.suggest.showProperties": false,
	// "editor.suggest.showEvents": false,
	// "editor.suggest.showOperators": false,
	// "editor.suggest.showUnits": false,
	// "editor.suggest.showValues": false,
	// "editor.suggest.showConstants": false,
	// "editor.suggest.showEnums": false,
	// "editor.suggest.showEnumMembers": false,
	// "editor.suggest.showKeywords": false,
	// "editor.suggest.showWords": false,
	// "editor.suggest.showColors": false,
	// "editor.suggest.showFiles": false,
	// "editor.suggest.showReferences": false,
	// "editor.suggest.showFolders": false,
	// "editor.suggest.showTypeParameters": false,
	// "editor.suggest.showSnippets": false,
	// "editor.suggest.showIssues": false,
	// "editor.suggest.showUsers": false,
	// "editor.parameterHints.enabled": false,
	// "editor.inlineSuggest.enabled": false,

	"[ahk2]": {
		// this is ridiculous
		"editor.formatOnSave": false,

		"editor.quickSuggestions": {
			"other": "off",
			"comments": "off",
			"strings": "off"
		}
	},

}
