{
    // Text Editor > Cursor
    "editor.cursorBlinking": "solid",

    // Text Editor > Font
    "editor.fontFamily": "Menlo",
    "editor.fontLigatures": false,
    "editor.fontSize": 12,
    "editor.fontVariations": false,
    "editor.fontWeight": "normal",

    // Text Editor > Formatting
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,

    // Text Editor > Diff Editor
    "diffEditor.ignoreTrimWhitespace": false,

    // Text Editor > Minimap
    "editor.minimap.enabled": false,

    // Text Editor > Suggestions
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": false,

    // Text Editor > Files
    "files.autoSave": "off",
    "files.enableTrash": true,
    "files.insertFinalNewline": true,
    "files.refactoring.autoSave": false,
    "files.restoreUndoStack": true,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": true,

    // OTHER

    // theme
    "workbench.colorTheme": "Atom One Dark",
    "workbench.iconTheme": "vs-seti",
    "workbench.colorCustomizations": {
        "scrollbar.shadow": "#0000",
        "focusBorder": "#0000"
    },

    // title bar
    "window.title": "${activeEditorMedium}",
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "visible",
    "window.customTitleBarVisibility": "never",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "window.enableMenuBarMnemonics": false,
    "window.customMenuBarAltFocus": false,

    // tab bar
    "breadcrumbs.enabled": false,
    "workbench.editor.enablePreview": true,
    "workbench.editor.wrapTabs": true,
    "workbench.editor.tabSizing": "fit",
    "workbench.editor.labelFormat": "default",
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.editor.showIcons": false,
    "workbench.editor.decorations.colors": false,
    "workbench.editor.decorations.badges": false,

    // explorer
    "explorer.sortOrder": "type",
    "explorer.autoReveal": false,
    "explorer.excludeGitIgnore": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    "workbench.editor.editorActionsLocation": "default",
    "workbench.activityBar.location": "hidden",
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "none",
    "explorer.decorations.colors": true,
    "explorer.decorations.badges": false,

    // gutter
    "editor.lineNumbers": "relative",
    "editor.folding": true,
    "editor.glyphMargin": false,
    "scm.diffDecorations": "all",
    "editor.rulers": [79, 100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.stickyScroll.enabled": false,
    "editor.guides.indentation": false,
    "editor.scrollBeyondLastLine": false,
    "editor.colorDecorators": false,

    "editor.renderWhitespace": "none",
    "editor.occurrencesHighlight": "off",
    "editor.autoClosingQuotes": "never",
    "editor.autoClosingBrackets": "never",
    "editor.autoSurround": "never",
    "editor.bracketPairColorization.enabled": false,
    "editor.codeLens": false,

    "editor.lightbulb.enabled": "off",
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.ambiguousCharacters": true,

    // prettier formatting
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.printWidth": 200,
    "prettier.tabWidth": 4,
    "prettier.useTabs": false,

    // new window start page
    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",
    "workbench.tips.enabled": false,

    // terminal
    "terminal.integrated.enableVisualBell": false,
    "terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "terminal.integrated.drawBoldTextInBrightColors": false,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.persistentSessionScrollback": 0,
    "debug.internalConsoleOptions": "neverOpen",

    // source control
    "git.confirmSync": false,
    "git.ignoreMissingGitWarning": true,
    "git.terminalAuthentication": false,

    // updates
    "update.mode": "manual",
    "update.showReleaseNotes": true,
    "update.enableWindowsBackgroundUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "telemetry.telemetryLevel": "off",
    "remote.WSL.downloadInBackground": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "workbench.enableExperiments": false,

    // extensions -> Vim
    "vim.useSystemClipboard": true,
    "vim.autoindent": false,
    "vim.enableNeovim": false,

    "vim.handleKeys": {
        "<C-n>": false,
        "<C-z>": false,
        "<C-y>": false
    },

    "vim.normalModeKeyBindings": [
        { "before": ["w"], "after": ["b"] },
        { "before": [";"], "after": [":"] }
    ],

    "vim.visualModeKeyBindings": [
        { "before": ["w"], "after": ["b"] },
        { "before": ["Tab"], "commands": ["tab"] },
        { "before": ["<S-Tab>"], "commands": ["outdent"] }
    ],

    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["p"],
            "commands": ["editor.action.clipboardPasteAction", "extension.vim_escape"]
        }
    ],

    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["p"],
            "commands": ["editor.action.clipboardPasteAction", "extension.vim_escape"]
        },
        {
            "before": ["y"],
            "commands": ["editor.action.clipboardCopyAction", "extension.vim_escape"]
        }
    ],

    // extensions -> Code Spell Checker
    "cSpell.language": "en-GB",
    "cSpell.languageSettings": [
        {
            "languageId": "*",
            "enabled": false
        },
        {
            "languageId": "markdown",
            "enabled": true
        }
    ],

    // extensions -> markdownlint
    "markdownlint.config": {
        "MD007": {
            "indent": 4
        }
    },

    // Features > Chat
    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,

    // other
    "workbench.localHistory.enabled": false,
    "workbench.editor.sharedViewState": false,
    "workbench.editor.restoreViewState": false,
    "window.autoDetectHighContrast": false,
    "editor.accessibilitySupport": "off",
    "extensions.ignoreRecommendations": true,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "window.restoreWindows": "none",
    "typescript.tsdk": "./node_modules/typescript/lib",
    "html.autoClosingTags": false,

    // "ty.inlayHints.callArgumentNames": false,
    // "ty.inlayHints.variableTypes": false,
    "terminal.integrated.initialHint": false,
    "workbench.settings.showAISearchToggle": false,
    "workbench.editor.useModal": "off"
}
