[
	// workbench
	{ "key": "cmd+t", "command": "workbench.action.files.newUntitledFile" },
	{ "key": "cmd+w", "command": "workbench.action.closeActiveEditor" },
	{ "key": "cmd+l", "command": "workbench.action.nextEditor" },
	{ "key": "cmd+h", "command": "workbench.action.previousEditor" },

	// terminal
	{ "key": "cmd+r", "command": "workbench.action.togglePanel" },
	{ "key": "cmd+t", "command": "workbench.action.terminal.new", "when": "terminalFocus" },
	{ "key": "cmd+w", "command": "workbench.action.terminal.kill", "when": "terminalFocus" },
	{ "key": "cmd+j", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[B" }, "when": "terminalFocus" },
	{ "key": "cmd+k", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[A" }, "when": "terminalFocus" },
	{ "key": "cmd+h", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[D" }, "when": "terminalFocus" },
	{ "key": "cmd+l", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[C" }, "when": "terminalFocus" },

	// suggestions
	{ "key": "cmd+s", "command": "editor.action.triggerSuggest" },
	{ "key": "k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible" },
	{ "key": "j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible" },
	{ "key": "enter", "command": "acceptAlternativeSelectedSuggestion", "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus" },

	// other
	{ "key": "cmd+p", "command": "workbench.action.showCommands" },
	{ "key": "cmd+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
	{ "key": "cmd+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },

	{ "key": "cmd+o", "command": "workbench.action.quickOpen" },

	{ "key": "cmd+e", "command": "workbench.action.focusSideBar" },
	{ "key": "cmd+e", "command": "workbench.action.focusActiveEditorGroup", "when": "sideBarFocus" },
	{ "key": "cmd+shift+e", "command": "workbench.action.toggleSidebarVisibility" },

	{ "key": "cmd+shift+1", "command": "workbench.view.explorer" },
	{ "key": "cmd+shift+2", "command": "workbench.view.search" },
	{ "key": "cmd+shift+3", "command": "workbench.view.scm" },
	{ "key": "cmd+shift+4", "command": "workbench.view.debug" },
	{ "key": "cmd+shift+5", "command": "workbench.view.extensions" },
	{ "key": "cmd+shift+6", "command": "workbench.view.remote" },

	// vim
	{ "key": "cmd+a", "command": "extension.vim_ctrl+[" },
]
