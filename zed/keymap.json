// https://zed.dev/docs/key-bindings

[
	// navigating buffers
	{
		"context": "Editor",
			"bindings": {
			    "cmd-l": "pane::ActivateNextItem",
			    "cmd-h": "pane::ActivatePreviousItem"
			}
	},

	// vim forwards and backwards
	{
		"context": "VimControl && !menu",
		"bindings": {
			"w": "vim::PreviousWordStart",
			"e": "vim::NextWordEnd"
		}
    },

    // tab and shift-tab to control indentation
	{
	   	"context": "vim_mode == visual && !menu",
	   	"bindings": {
	  		"tab": ["workspace::SendKeystrokes", "> g v"],
	       	"shift-tab": ["workspace::SendKeystrokes", "< g v"]
	   	}
	}
]
