{
    "autoMemoryEnabled": false,

    "permissions": {
        "defaultMode": "dontAsk",

        "additionalDirectories": [
            "~/Github",
            "~/Desktop"
        ],

        "allow": [
            "Bash",
            "Read(~/Github/**)",
            "Edit(~/Github/**)",
            "Read(~/Desktop/**)",
            "Edit(~/Desktop/**)"
        ]
    },

    "sandbox": {
        "enabled": true,
        "failIfUnavailable": true,
        "allowUnsandboxedCommands": false,
        "filesystem": {
            "allowRead": ["~/Github", "~/Desktop"],
            "allowWrite": ["~/Github", "~/Desktop"],
            "denyRead": ["~/"]
        }
    }
}

